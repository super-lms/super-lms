# SUPER LMS Frontend Environment Variables
# Copy this file to .env for local development if needed.
# Railway should use real environment variables in the Railway dashboard.

# Local backend API
VITE_API_BASE_URL=http://localhost:3000

# Railway backend API example
# Replace this with your deployed backend URL when Railway backend is live.
# VITE_API_BASE_URL=https://your-super-lms-backend.up.railway.app

# Standalone RTI / Student Support app. When set, Teachers and Observers see
# an RTI menu item that opens this address in a new tab.
VITE_RTI_APP_URL=http://localhost:5050
